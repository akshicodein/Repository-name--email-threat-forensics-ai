# Threat intel APIs — all optional; module falls back to mock/basic data without them
IPINFO_TOKEN=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Database (SQLite for hackathon dev)
DATABASE_PATH=database/threat_memory.db

# Neo4j (optional — graph output still works as a plain dict without it)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Correlation tuning
DNA_SIMILARITY_THRESHOLD=0.75
CAMPAIGN_CONFIDENCE_THRESHOLD=0.7
